WESCALP_DB_PASSWORD=troque-isto

# Avisos do vigia (serviço health). Sem nenhum canal, o aviso só vai para o log.
# Webhook genérico: recebe POST {"text": "..."}. Slack: URL do incoming webhook.
# Discord: URL do webhook com /slack no fim (https://discord.com/api/webhooks/ID/TOKEN/slack).
# WESCALP_ALERT_WEBHOOK=
# Telegram: token do @BotFather e o chat_id de quem recebe (precisa dos dois).
# WESCALP_TELEGRAM_TOKEN=
# WESCALP_TELEGRAM_CHAT_ID=
# Segundos entre verificações e de quantas em quantas horas repetir enquanto estiver ruim (0 = não repete).
# WESCALP_HEALTH_INTERVAL_S=60
# WESCALP_HEALTH_REPEAT_HOURS=6
# Testar o canal: docker compose run --rm health python -m wescalp.health --test-alert
